{
  "custom": {
    "id": "55e8b19c-d73e-4a3e-8af8-f6a01a808c16"
  },
  "params": {
    "configuration": {},
    "value": ""
  },
  "propConfig": {
    "custom.id": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\tfrom java.util import UUID\n\treturn UUID.randomUUID().toString()",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.configuration": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 32,
      "width": 297
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Sample"
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "\"material/\" + {../Field.props.text}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "cursor": "pointer",
                "margin": "6px"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Field"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.placeholder": {
                "binding": {
                  "config": {
                    "path": "view.params.configuration"
                  },
                  "transforms": [
                    {
                      "code": "\treturn launchpad.dashboard.getConfiguration(value, \"placeholder\", \"\")",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.value"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/dashboard/entry"
              }
            },
            "scripts": {
              "customMethods": [],
              "extensionFunctions": null,
              "messageHandlers": [
                {
                  "messageType": "icon-selection",
                  "pageScope": true,
                  "script": "\tid = self.view.custom.id\n\tif id == payload[\"id\"]:\n\t\ticon = payload[\"icon\"]\n\t\tself.props.text = icon",
                  "sessionScope": false,
                  "viewScope": false
                }
              ]
            },
            "type": "ia.input.text-field"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "draggable": false,
                    "id": "icon-picker",
                    "modal": true,
                    "overlayDismiss": true,
                    "resizable": true,
                    "showCloseIcon": true,
                    "title": "Choose Icon",
                    "type": "open",
                    "viewParams": {
                      "icon": "{/root/FlexContainer/Field.props.text}",
                      "id": "{view.custom.id}"
                    },
                    "viewPath": "Launchpad/Kpi/EmbeddedViews/Dashboard/Configuration/Parameter Types/Popups/Icon Picker",
                    "viewportBound": false
                  },
                  "scope": "C",
                  "type": "popup"
                },
                "onKeyDown": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif event.key in ('Enter', ' '):\n\t\ticon = self.view.getChild('root').getChild('FlexContainer').getChild('Field').props.text\n\t\tsystem.perspective.openPopup('icon-picker', 'Launchpad/Kpi/EmbeddedViews/Dashboard/Configuration/Parameter Types/Popups/Icon Picker',\n\t\t\tparams={'icon': icon, 'id': self.view.custom.id}, title='Choose Icon',\n\t\t\tmodal=True, draggable=False, resizable=True, showCloseIcon=True, overlayDismiss=True)"
                  }
                }
              }
            },
            "meta": {
              "name": "Search",
              "tabIndex": 0,
              "tooltip": {
                "enabled": true,
                "text": "Choose icon"
              }
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
            "props": {
              "path": "material/search",
              "style": {
                "cursor": "pointer",
                "marginLeft": "6px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}