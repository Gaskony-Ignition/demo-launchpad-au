      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t# When this dock is opened, the current \u0027edit dashboard\u0027 properties\n\t# are passed to this view in the \u0027currEdit\u0027 param. When this \u0027Cancel\u0027\n\t# button is pressed, the dashboard.objects.edit object (besides the widgets) \n\t# is set equal to the \u0027currEdit\u0027 param (reverting the \u0027edit dashboard\u0027 object,\n\t# effectively cancelling any changes that the user could have made).\n\t\n\tfor key, value in self.view.params.currEdit.iteritems():\n\t\tself.session.custom.launchpad.dashboard.objects.edit[key] \u003d value\n\n\tsystem.perspective.closeDock(\u0027editDashDetails\u0027)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Cancel"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "style": {
                "border-width": "1px",
                "classes": "launchpad/kpi/header/button-unselected",
                "margin": "0px",
                "width": "100px"
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t# Due to the fact that the components on this view contain\n\t# bidirectional bindings to the \u0027edit dashboard\u0027 session\n\t# custom property object (the changes are applied right after\n\t# the user enters new info), this \u0027Done\u0027 button only needs\n\t# to close this dock.\n\t\n\tsystem.perspective.closeDock(\u0027editDashDetails\u0027)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Done"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "style": {
                "border-width": "1px",
                "classes": "launchpad/kpi/header/button-selected",
                "margin": "0px",
                "width": "100px"
              },
              "text": "Done"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "DoneAndCancel"
