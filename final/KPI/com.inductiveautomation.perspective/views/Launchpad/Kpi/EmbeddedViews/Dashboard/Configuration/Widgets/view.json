{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 580
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "launchpadEditDashboard",
          "name": "Dashboard"
        },
        "position": {
          "basis": "400px",
          "grow": 1
        },
        "propConfig": {
          "custom.availableWidgetsDS": {
            "binding": {
              "config": {
                "queryPath": "Launchpad/Dashboard/Widget/Installed Widgets",
                "returnFormat": "dataset"
              },
              "type": "query"
            }
          },
          "props.availableWidgets": {
            "binding": {
              "config": {
                "struct": {
                  "availableWidgetsDS": "{this.custom.availableWidgetsDS}",
                  "editGridCols": "{session.custom.launchpad.dashboard.objects.edit.gridCols}",
                  "editGridRows": "{session.custom.launchpad.dashboard.objects.edit.gridRows}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tavailableWidgetsDS \u003d system.dataset.toPyDataSet(value[\u0027availableWidgetsDS\u0027])\n\treturn launchpad.dashboard.getInstalledWidgets(availableWidgetsDS, value[\u0027editGridRows\u0027], value[\u0027editGridCols\u0027])",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.fixed.cellSize": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.cellSize"
              },
              "type": "property"
            }
          },
          "props.fixed.columnCount": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridCols"
              },
              "type": "property"
            }
          },
          "props.fixed.columnGutterSize": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridColGutterSize"
              },
              "type": "property"
            }
          },
          "props.fixed.rowCount": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridRows"
              },
              "type": "property"
            }
          },
          "props.fixed.rowGutterSize": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridRowGutterSize"
              },
              "type": "property"
            }
          },
          "props.grid": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.grid"
              },
              "type": "property"
            }
          },
          "props.stretch.columnCount": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridCols"
              },
              "type": "property"
            }
          },
          "props.stretch.columnGutterSize": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridColGutterSize"
              },
              "type": "property"
            }
          },
          "props.stretch.rowCount": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridRows"
              },
              "type": "property"
            }
          },
          "props.stretch.rowGutterSize": {
            "binding": {
              "config": {
                "path": "session.custom.launchpad.dashboard.objects.edit.gridRowGutterSize"
              },
              "type": "property"
            }
          },
          "props.widgets": {
            "binding": {
              "config": {
                "struct": {
                  "columnCount": "{this.props.stretch.columnCount}",
                  "rowCount": "{session.custom.launchpad.dashboard.objects.current.gridRows}",
                  "widgets": "{session.custom.launchpad.dashboard.objects.edit.widgets}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\twidgets \u003d value[\"widgets\"]\n\t\t\n\twidgets \u003d launchpad.dashboard.getWidgets(widgets, False, value[\"rowCount\"], value[\u0027columnCount\u0027], True)\n\treturn [] if value \u003d\u003d None else widgets",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif origin \u003d\u003d \"Browser\":\n\t\tlaunchpad.dashboard.addUpdateWidget(self)"
            }
          }
        },
        "props": {
          "editingToggle": false,
          "fixed": {},
          "isEditing": true,
          "pack": false,
          "stretch": {}
        },
        "type": "ia.display.dashboard"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}