{
  "custom": {
    "selection": [
      "0/0"
    ]
  },
  "params": {
    "id": "",
    "mode": "realtime"
  },
  "propConfig": {
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.mode": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 476,
      "width": 342
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onItemClicked": {
              "config": {
                "script": "\tlaunchpad.views.tagTreeItemClicked(self, event)"
              },
              "scope": "G",
              "type": "script"
            }
          },
          "dom": {
            "onMouseMove": {
              "config": {
                "script": "\tself.props.interactable \u003d False"
              },
              "scope": "G",
              "type": "script"
            },
            "onMouseOver": {
              "config": {
                "script": "\tself.props.interactable \u003d False"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Tags"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.items": {
            "binding": {
              "config": {
                "struct": {
                  "date": "now(0)",
                  "mode": "{view.params.mode}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value[\"mode\"] \u003d\u003d \"realtime\":\n\t\tret \u003d launchpad.tags.browseTags()\n\telse:\n\t\tret \u003d launchpad.tags.browseHistoryTags()\n\treturn ret",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.selection": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.custom.selection"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "appearance": {
            "defaultNodeIcons": {
              "collapsed": {
                "color": "#5F707E",
                "path": "material/folder"
              },
              "empty": {
                "color": "#869DB1",
                "path": "material/stop"
              },
              "expanded": {
                "color": "#5F707E",
                "path": "material/folder_open"
              }
            },
            "expandIcons": {
              "collapsed": {
                "color": "#869DB1",
                "path": "material/arrow_right"
              },
              "empty": {
                "color": "#869DB1"
              },
              "expanded": {
                "color": "#869DB1",
                "path": "material/arrow_drop_down"
              }
            }
          },
          "interactable": false,
          "selection": [
            "0/0"
          ],
          "selectionData": [
            {
              "itemPath": "0/0",
              "value": {
                "folder": "[Launchpad]KPI",
                "hasChildren": true
              }
            }
          ]
        },
        "type": "ia.display.tree"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tlaunchpad.views.tagTreeSelect(self, event)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Select"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.custom.selection"
              },
              "transforms": [
                {
                  "code": "\treturn len(value) \u003e 0",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "border-width": "1px",
            "classes": "launchpad/kpi/header/button-selected",
            "margin": "0px"
          },
          "text": "Select"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "10px"
      }
    },
    "type": "ia.container.flex"
  }
}