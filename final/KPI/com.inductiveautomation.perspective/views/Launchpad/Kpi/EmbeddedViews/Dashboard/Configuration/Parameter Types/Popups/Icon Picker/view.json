                  "pages": "{parent.custom.pages}",
                  "total": "{parent.custom.total}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\ticons = value[\"icons\"]\n\tpage = value[\"page\"]\n\ttotal = value[\"total\"]\n\tpages = value[\"pages\"]\n\tpageSize = value[\"pageSize\"]\n\tstartIdx = page * pageSize\n\tendIdx = startIdx + pageSize\n\tendIdx = total if endIdx > total else endIdx\n\treturn icons[startIdx:endIdx]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "alignContent": "center",
          "elementPosition": {
            "basis": "32px",
            "grow": 0,
            "shrink": 0
          },
          "justify": "center",
