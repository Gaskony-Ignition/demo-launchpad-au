{
  "custom": {},
  "params": {
    "icon": "home",
    "id": ""
  },
  "propConfig": {
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 475,
      "width": 450
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "SearchLabel"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "marginLeft": "6px",
                "marginRight": "6px"
              },
              "text": "Search"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SearchText"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"\""
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/dashboard/entry",
                "marginRight": "6px"
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "name": "SearchContainer"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "props": {
          "style": {
            "marginBottom": "6px",
            "marginTop": "6px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Icons"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "icons": "{parent.custom.searchIcons}",
                  "page": "{parent.custom.page}",
                  "pageSize": "{parent.custom.pageSize}",
                  "pages": "{parent.custom.pages}",
                  "total": "{parent.custom.total}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn launchpad.views.iconPickerPageInstances(self, value)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "alignContent": "center",
          "elementPosition": {
            "basis": "32px",
            "grow": 0,
            "shrink": 0
          },
          "justify": "center",
          "key": "value",
          "path": "Launchpad/Kpi/EmbeddedViews/Dashboard/Configuration/Parameter Types/Popups/Icon",
          "style": {
            "gap": "10px"
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false,
          "wrap": "wrap"
        },
        "scripts": {
          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "colorClicked",
              "pageScope": true,
              "script": "\tcolor = payload[\"color\"]\n\tself.view.params.color = color",
              "sessionScope": false,
              "viewScope": false
            }
          ]
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tself.view.getChild(\"root\").custom.page = 0\n\t\t"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif event.key in ('Enter', ' '):\n\t\tself.view.getChild(\"root\").custom.page = 0\n\t\t\t"
                  }
                }
              }
            },
            "meta": {
              "name": "Beg",
              "tabIndex": 0,
              "tooltip": {
                "enabled": true,
                "text": "First page"
              }
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "path": "material/first_page",
              "style": {
                "cursor": "pointer"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tpage = self.view.getChild(\"root\").custom.page\n\t\n\tif (page - 1) >= 0:\n\t\tpage -= 1\n\t\n\tself.view.getChild(\"root\").custom.page = page\n\t\t"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tlaunchpad.views.iconPickerPreviousPageOnKey(self, event)"
                  }
                }
              }
            },
            "meta": {
              "name": "Back",
              "tabIndex": 0,
              "tooltip": {
                "enabled": true,
                "text": "Previous page"
              }
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "path": "material/chevron_left",
              "style": {
                "cursor": "pointer"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "PageNumber"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "({/root.custom.page} + 1) + \" of \" + {/root.custom.pages}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "marginLeft": "6px",
                "marginRight": "6px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tpage = self.view.getChild(\"root\").custom.page\n\tpages = self.view.getChild(\"root\").custom.pages\n\t\n\tif (page + 1) <= (pages - 1):\n\t\tpage += 1\n\t\n\tself.view.getChild(\"root\").custom.page = page\n\t\t"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tlaunchpad.views.iconPickerNextPageOnKey(self, event)"
                  }
                }
              }
            },
            "meta": {
              "name": "Forward",
              "tabIndex": 0,
              "tooltip": {
                "enabled": true,
                "text": "Next page"
              }
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "path": "material/chevron_right",
              "style": {
                "cursor": "pointer"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tpages = self.view.getChild(\"root\").custom.pages\n\tself.view.getChild(\"root\").custom.page = pages - 1"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif event.key in ('Enter', ' '):\n\t\tpages = self.view.getChild(\"root\").custom.pages\n\t\tself.view.getChild(\"root\").custom.page = pages - 1"
                  }
                }
              }
            },
            "meta": {
              "name": "End",
              "tabIndex": 0,
              "tooltip": {
                "enabled": true,
                "text": "Last page"
              }
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "path": "material/last_page",
              "style": {
                "cursor": "pointer"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "PageContainer"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "marginTop": "6px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "IconLabel"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "marginLeft": "6px",
                "marginRight": "6px"
              },
              "text": "Icon"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "IconName"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.icon"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/dashboard/entry"
              }
            },
            "type": "ia.input.text-field"
          },
          {
            "meta": {
              "name": "Preview"
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "\"material/\" + {../IconName.props.text}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "marginLeft": "6px",
                "marginRight": "6px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "PreviewContainer"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "props": {
          "style": {
            "marginBottom": "10px",
            "marginTop": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tid = self.view.params.id\n\ticon = self.view.params.icon\n\tsystem.perspective.sendMessage(messageType=\"iconSelection\", payload={\"id\":id, \"icon\":icon})\n\tsystem.perspective.closePopup(id=\"icon-picker\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Select"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "props": {
          "style": {
            "border-width": "1px",
            "classes": "launchpad/kpi/header/button-selected",
            "margin": "0px"
          },
          "text": "Select"
        },
        "type": "ia.input.button"
      }
    ],
    "custom": {
      "page": 0,
      "pageSize": 70
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "custom.icons": {
        "access": "PRIVATE",
        "binding": {
          "config": {
            "expression": "now(0)"
          },
          "transforms": [
            {
              "code": "\treturn launchpad.views.iconPickerIconList(self, value)",
              "type": "script"
            }
          ],
          "type": "expr"
        }
      },
      "custom.pages": {
        "binding": {
          "config": {
            "struct": {
              "pageSize": "{this.custom.pageSize}",
              "total": "{this.custom.total}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\timport math\n\treturn int(math.ceil(value[\"total\"]  / float(value[\"pageSize\"])))",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "custom.searchIcons": {
        "binding": {
          "config": {
            "struct": {
              "icons": "{this.custom.icons}",
              "search": "{./SearchContainer/SearchText.props.text}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\treturn launchpad.views.iconPickerSearchIcons(self, value)",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "custom.total": {
        "binding": {
          "config": {
            "path": "this.custom.searchIcons"
          },
          "transforms": [
            {
              "code": "\treturn len(value)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column"
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "iconSelected",
          "pageScope": true,
          "script": "\tself.view.params.icon = payload[\"icon\"]",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}