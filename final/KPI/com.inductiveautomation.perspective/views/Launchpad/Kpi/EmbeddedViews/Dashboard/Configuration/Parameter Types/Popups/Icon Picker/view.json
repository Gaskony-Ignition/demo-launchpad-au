                    "script": "\tpage = self.view.getChild(\"root\").custom.page\n\tpages = self.view.getChild(\"root\").custom.pages\n\t\n\tif (page - 1) >= 0:\n\t\tpage -= 1\n\t\n\tself.view.getChild(\"root\").custom.page = page\n\t\t"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif event.key in ('Enter', ' '):\n\t\tpage = self.view.getChild(\"root\").custom.page\n\t\tpages = self.view.getChild(\"root\").custom.pages\n\t\t\n\t\tif (page - 1) >= 0:\n\t\t\tpage -= 1\n\t\t\n\t\tself.view.getChild(\"root\").custom.page = page\n\t\t\t"
