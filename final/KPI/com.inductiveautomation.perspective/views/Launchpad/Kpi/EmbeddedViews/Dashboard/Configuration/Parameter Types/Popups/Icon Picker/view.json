      "custom.pages": {
        "binding": {
          "config": {
            "struct": {
              "pageSize": "{this.custom.pageSize}",
              "total": "{this.custom.total}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\timport math\n\treturn int(math.ceil(value[\"total\"]  / float(value[\"pageSize\"])))",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "custom.searchIcons": {
        "binding": {
          "config": {
            "struct": {
              "icons": "{this.custom.icons}",
              "search": "{./FlexContainer_1/TextField.props.text}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ticons = self.custom.icons\n\tsearch = value[\"search\"]\n\tret = []\n\tfor i in range(len(icons)):\n\t\ticon = icons[i]\n\t\tif search == None or search == \"\" or search in icon[\"icon\"]:\n\t\t\tret.append(icon)\n\treturn ret",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "custom.total": {
        "binding": {
          "config": {
            "path": "this.custom.searchIcons"
          },
          "transforms": [
            {
              "code": "\treturn len(value)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
