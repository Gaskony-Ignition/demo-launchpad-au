                    "stroke": {
                      "color": "var(--kpi-primary)",
                      "dashArray": 0,
                      "opacity": 1,
                      "width": 1
                    }
                  },
                  "muted": {
                    "fill": {
                      "color": "var(--kpi-primary)",
                      "opacity": 0.4
                    },
                    "stroke": {
                      "color": "var(--kpi-primary)",
                      "dashArray": 0,
                      "opacity": 0.4,
                      "width": 1
                    }
                  },
                  "normal": {
                    "fill": {
                      "color": "var(--kpi-primary)",
                      "opacity": 0.8
                    },
                    "stroke": {
                      "color": "var(--kpi-primary)",
                      "dashArray": 0,
                      "opacity": 0.8,
                      "width": 1
                    }
                  },
                  "selected": {
                    "fill": {
                      "color": "var(--kpi-primary)",
                      "opacity": 1
                    },
                    "stroke": {
                      "color": "var(--kpi-primary)",
                      "dashArray": 0,
                      "opacity": 1,
                      "width": 1
                    }
                  }
                },
                "type": "line"
              },
              "enabled": true,
              "plot": 0,
              "selectable": true,
              "visible": true
