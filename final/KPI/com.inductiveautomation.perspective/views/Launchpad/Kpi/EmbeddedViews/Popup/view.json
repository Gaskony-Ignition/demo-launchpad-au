{
  "custom": {
    "documentation": "Daily Production",
    "projectName": "",
    "tagHistory": [
      {
        "aggregate": "Average",
        "alias": "value"
      }
    ],
    "tagName": "DailyProduction"
  },
  "params": {
    "historyProvider": "launchpad",
    "path": "[Launchpad]KPI/DailyProduction"
  },
  "propConfig": {
    "custom.documentation": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.documentation"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.projectName": {
      "binding": {
        "config": {
          "expression": "lower({[System]Gateway/SystemName})"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.tagHistory": {
      "persistent": true
    },
    "custom.tagHistory[0].path": {
      "binding": {
        "config": {
          "struct": {
            "historyProvider": "{view.params.historyProvider}",
            "path": "{view.params.path}",
            "projectName": "{view.custom.projectName}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn \"histprov:\" + value.historyProvider + \":/drv:\" + value.projectName + \":Launchpad:/tag:\" + value.path.replace(\"[Launchpad]\",\"\")",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.tagName": {
      "binding": {
        "config": {
          "path": "view.params.path"
        },
        "transforms": [
          {
            "code": "\treturn value.split(\"/\")[-1]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.historyProvider": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "documentation": "{view.custom.documentation}",
                  "tagName": "{view.custom.tagName}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif len(value.documentation) > 0:\n\t\tname = value.documentation\n\telse:\n\t\tname =  value.tagName\n\t\n\treturn name + \" Historical Data\"",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/header"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "PowerChart"
        },
        "position": {
          "basis": "560px",
          "grow": 1
        },
        "propConfig": {
          "props.pens[0].data.source": {
            "binding": {
              "config": {
                "struct": {
                  "historyProvider": "{view.params.historyProvider}",
                  "path": "{view.params.path}",
                  "projectName": "{view.custom.projectName}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\treturn \"histprov:\" + value.historyProvider + \":/drv:\" + value.projectName + \":Launchpad:/tag:\" + value.path.replace(\"[Launchpad]\",\"\")",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.pens[0].name": {
            "binding": {
              "config": {
                "struct": {
                  "documentation": "{view.custom.documentation}",
                  "tagName": "{view.custom.tagName}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif len(value.documentation) > 0:\n\t\treturn value.documentation\n\telse:\n\t\treturn value.tagName",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "config": {
            "measureOfTime": "minutes",
            "rangeEndDate": {
              "$": [
                "ts",
                0,
                1749564067478
              ],
              "$ts": 1749564049465
            },
            "rangeStartDate": {
              "$": [
                "ts",
                0,
                1749564067478
              ],
              "$ts": 1749558667465
            },
            "unitOfTime": 90,
            "visibility": {
              "buttons": {
                "showRangeBrushButton": false,
                "showTagBrowserButton": false
              }
            },
            "dateFormat": "DD/MM/YYYY",
            "timeFormat": "HH:mm:ss"
          },
          "dataColumns": {
            "penControl": {
              "axis": false,
              "plot": false
            }
          },
          "interaction": {
            "chartZoomLevel": 1,
            "mode": "xTrace",
            "rangeZoomLevel": 1,
            "xTrace": {
