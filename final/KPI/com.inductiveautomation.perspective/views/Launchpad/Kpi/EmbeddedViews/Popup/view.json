          ],
          "plots": [
            {
              "color": "transparent",
              "markers": [],
              "relativeWeight": 1,
              "style": {
                "classes": ""
              }
            }
          ],
          "timeAxis": {
            "tick": {
              "label": {
                "format": "Auto"
              }
            }
          }
        },
        "type": "ia.chart.powerchart"
      },
      {
        "meta": {
