{
  "custom": {
    "background": "linear-gradient(to right,var(--kpi-highlight) 50.0%, var(--kpi-object) 0%)",
    "engHigh": 100,
    "engLow": 0,
    "format": "#,##0.#",
    "label": "Placeholder",
    "progress": 0.5,
    "units": "TBD",
    "value": 50
  },
  "params": {
    "path": "[Launchpad]KPI/Placeholder"
  },
  "propConfig": {
    "custom.background": {
      "binding": {
        "config": {
          "path": "view.custom.progress"
        },
        "transforms": [
          {
            "code": "\treturn 'linear-gradient(to right,var(--kpi-highlight) %s%%, var(--kpi-object) 0%%)' % (value*100.0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.engHigh": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngHigh"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.engLow": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngLow"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.FormatString"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.Documentation"
        },
        "transforms": [
          {
            "code": "\tif value == '':\n\t\treturn self.params.path.split('/')[-1]\n\telse:\n\t\treturn value",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.progress": {
      "binding": {
        "config": {
          "struct": {
            "engHigh": "{view.custom.engHigh}",
            "engLow": "{view.custom.engLow}",
            "value": "{view.custom.value}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tfullRange = value.engHigh - value.engLow\n\tvalueRange = value.value - value.engLow\n\treturn 1.0 * valueRange / fullRange",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.units": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngUnit"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 178,
      "width": 294
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/header",
            "textAlign": "start"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "basis": "20px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberFormat({view.custom.value},{view.custom.format})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/number",
                "color": "--kpi-highlight",
                "margin-bottom": 12,
                "textAlign": "start"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Progress"
            },
            "position": {
              "basis": "10px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.background": {
                "binding": {
                  "config": {
                    "path": "view.custom.background"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "borderBottomLeftRadius": 4,
                "borderBottomRightRadius": 4,
                "borderTopLeftRadius": 4,
                "borderTopRightRadius": 4
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Total"
            },
            "position": {
              "basis": "200px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberFormat({view.custom.engHigh},{view.custom.format}) +  ' ' + {view.custom.units}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/units",
                "margin-top": 4,
                "textAlign": "end"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "justify": "space-between",
          "style": {
            "margin-top": 18,
            "overflow": "hidden",
            "padding-left": 6
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\tviewParams = {'path': self.view.params.path, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\tpopupTitle = self.view.custom.label\n\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          },
          "scope": "G",
          "type": "script"
        },
        "onKeyDown": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tif event.key in ('Enter', ' '):\n\t\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\t\tviewParams = {'path': self.view.params.path, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\t\tpopupTitle = self.view.custom.label\n\t\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          }
        }
      }
    },
    "meta": {
      "name": "root",
      "tabIndex": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/card",
        "cursor": "pointer"
      }
    },
    "type": "ia.container.flex"
  }
}