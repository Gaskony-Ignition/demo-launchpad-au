{
  "custom": {
    "aggMode": "Maximum",
    "history": [],
    "tags": []
  },
  "params": {
    "aggMode": "Maximum",
    "path1": "",
    "path2": "",
    "title": "Title"
  },
  "propConfig": {
    "custom.aggMode": {
      "binding": {
        "config": {
          "path": "view.params.aggMode"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "config": {
          "aggregate": "MinMax",
          "avoidScanClassValidation": true,
          "dateRange": {
            "mostRecent": "24",
            "mostRecentUnits": "HOUR"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "polling": {
            "enabled": true,
            "rate": "30"
          },
          "preventInterpolation": false,
          "returnFormat": "Wide",
          "returnSize": {
            "delay": "1",
            "delayUnits": "HOUR",
            "type": "INTERVAL"
          },
          "tags": "{view.custom.tags}",
          "valueFormat": "DOCUMENT"
        },
        "transforms": [
          {
            "code": "\t# Timeseries chart expects 'time' rather than 't_stamp'.\n\tfor row in value:\n\t\trow['time'] = row.pop('t_stamp')\t\t\n\t\t\n\treturn value",
            "type": "script"
          }
        ],
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "aggMode": "{view.custom.aggMode}",
            "tagPath1": "{view.params.path1}",
            "tagPath2": "{view.params.path2}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tdef getTagName(tagPath):\n\t\t# Get name from Documentation of tag.\n\t\ttagName = system.tag.read('{tagPath}.Documentation'.format(tagPath = tagPath)).value\n\t\t\n\t\tif not tagName:\n\t\t\t# No name found in Documentation. Use tag name instead.\n\t\t\ttagName = system.tag.read('{tagPath}.name'.format(tagPath = tagPath)).value\n\t\t\t\n\t\t# Get the eng units of tag.\n\t\tengUnit = system.tag.read('{tagPath}.engUnit'.format(tagPath = tagPath)).value\n\t\t\n\t\tif engUnit:\n\t\t\treturn '{tagName} ({engUnit})'.format(tagName = tagName, engUnit = engUnit)\n\t\telse:\n\t\t\treturn tagName\n\t\t\t\n\tdef getRealtimePath(historicalPath):\n\t\ttagDelim = \":/tag:\"\n\t\t\n\t\tparts = historicalPath.rsplit(tagDelim, 1)\n\t\t\n\t\textractedPath = \"\"\n\t\t\n\t\tif len(parts) > 1:\n\t\t\textractedPath = parts[1]\n\t\telse:\n\t\t\textractedPath = historicalPath\n\t\n\t\t# Default fallback.\n\t\tprovName = \"default\"\n\t\t\n\t\tif tagDelim in historicalPath:\n\t\t\tsegBeforeTagDelim = historicalPath.split(tagDelim, 1)[0]\n\t\t\tlastColonIndex = segBeforeTagDelim.rfind(\":\")\n\t\t\t\n\t\t\tif lastColonIndex != -1:\n\t\t\t\tprovName = segBeforeTagDelim[lastColonIndex + 1:]\n\t\t\telse:\n\t\t\t\tprovName = segBeforeTagDelim.rsplit(\":\", 1)[-1]\n\t\t\t\t\n\t\t\t\tif provName.startswith(\"histprov\"):\n\t\t\t\t\tprovName = provName.split(\":\", 1)[-1]\n\t\t\t\tif not provName:\n\t\t\t\t\tprovName = \"default\"\n\t\t\t\t\t\n\t\treturn \"[{}]{}\".format(provName, extractedPath)\n\t\t\n\ttags = []\n\t\n\ttagPath1 = value.get('tagPath1')\n\ttagPath2 = value.get('tagPath2')\n\t\n\trealtimePath1 = getRealtimePath(tagPath1) if \":/tag:\" in tagPath1 else tagPath1\n\trealtimePath2 = getRealtimePath(tagPath2) if \":/tag:\" in tagPath2 else tagPath2\n\t\n\tif tagPath1:\n\t\ttags.append({\"aggregate\": value.get('aggMode'), \"alias\": getTagName(realtimePath1), \"path\": realtimePath1})\n\t\t\n\tif tagPath2:\n\t\ttags.append({\"aggregate\": value.get('aggMode'), \"alias\": getTagName(realtimePath2), \"path\": realtimePath2})\n\t\t\n\treturn tags",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.aggMode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path1": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path2": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 343,
      "width": 462
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/header"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "LabelInterval"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "text": "Aggregation:"
                },
                "type": "ia.display.label"
              },
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t# Stop propagation to prevent opening the history popup when interacting with the dropdown.\n\tpass"
                      },
                      "scope": "G",
                      "stopPropagation": true,
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Dropdown"
                },
                "position": {
                  "basis": "155px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.aggMode"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "options": [
                    {
                      "label": "Average",
                      "value": "Average"
                    },
                    {
                      "label": "MinMax",
                      "value": "MinMax"
                    },
                    {
                      "label": "LastValue",
                      "value": "LastValue"
                    },
                    {
                      "label": "SimpleAverage",
                      "value": "SimpleAverage"
                    },
                    {
                      "label": "Sum",
                      "value": "Sum"
                    },
                    {
                      "label": "Minimum",
                      "value": "Minimum"
                    },
                    {
                      "label": "Maximum",
                      "value": "Maximum"
                    },
                    {
                      "label": "DurationOn",
                      "value": "DurationOn"
                    },
                    {
                      "label": "DurationOff",
                      "value": "DurationOff"
                    },
                    {
                      "label": "CountOn",
                      "value": "CountOn"
                    },
                    {
                      "label": "CountOff",
                      "value": "CountOff"
                    },
                    {
                      "label": "Count",
                      "value": "Count"
                    },
                    {
                      "label": "Range",
                      "value": "Range"
                    },
                    {
                      "label": "Variance",
                      "value": "Variance"
                    },
                    {
                      "label": "StdDev",
                      "value": "StdDev"
                    },
                    {
                      "label": "PctGood",
                      "value": "PctGood"
                    },
                    {
                      "label": "PctBad",
                      "value": "PctBad"
                    }
                  ],
                  "style": {
                    "classes": "launchpad/kpi/components/bar-chart/entry",
                    "width": "155px"
                  }
                },
                "type": "ia.input.dropdown"
              }
            ],
            "meta": {
              "name": "AggMode"
            },
            "props": {
              "style": {
                "gap": "10px"
              },
              "wrap": "wrap"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "TitleAndAgg"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "row-gap": "15px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "TimeSeriesChart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.plots[0].trends[0].columns": {
            "binding": {
              "config": {
                "path": "view.custom.tags"
              },
              "transforms": [
                {
                  "code": "\tcolumns = []\n\t\n\tcolors = [\"var(--kpi-primary)\", \"var(--kpi-highlight)\"]\n\tindex = 0\n\t\n\tfor tag in value:\n\t\ttry:\n\t\t\tcolor = colors[index]\n\t\texcept:\n\t\t\t# Widget is designed to handle two tags. But if more than 1 tag is added\n\t\t\t# then let the chart pick a color.\n\t\t\tcolor = None\n\t\t\n\t\tcolumn = {\"key\": tag.get('alias'), \"color\": color, \"styles\": {\"normal\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\", \"opacity\": None}}, \"highlighted\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\", \"opacity\": None}}, \"selected\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\",\"opacity\": None}}, \"muted\": {\"stroke\": {\"color\": \"\", \"width\": 2, \"opacity\": None, \"dashArray\": None},\n\t\t\t\"fill\": {\"color\": \"\", \"opacity\": None}}}}\n\t\t\t\n\t\tcolumns.append(column)\n\t\t\n\t\tindex = index + 1\n\t\t\n\treturn columns",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.series[0].data": {
            "binding": {
              "config": {
                "path": "view.custom.history"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "legend": {
            "visible": true
          },
          "plots": [
            {
              "axes": [],
              "markers": [],
              "relativeWeight": 1,
              "trends": [
                {
                  "axis": "",
                  "baselines": [],
                  "breakLine": true,
                  "interpolation": "curveLinear",
                  "radius": 2,
                  "series": "Data",
                  "stack": true,
                  "type": "line",
                  "visible": true
                }
              ]
            }
          ],
          "series": [
            {
              "name": "Data"
            }
          ],
          "timeRange": {
            "dateFormat": "DD/MM/YYYY",
            "timeFormat": "HH:mm:ss"
          },
          "xTrace": {
            "infoBox": {
              "dateFormat": "DD/MM/YYYY",
              "timeFormat": "HH:mm:ss"
            }
          },
          "timeAxis": {
            "tick": {
              "label": {
                "format": "HH:mm"
              }
            }
          }
        },
        "type": "ia.chart.timeseries"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath = 'Launchpad/Kpi/EmbeddedViews/PopupDualTag'\n\ttags = self.view.custom.tags\n\tif len(tags) == 0:\n\t\tpath1 = ''\n\t\tpath2 = ''\n\telif len(tags) == 1:\n\t\tpath1 = tags[0]['path']\n\t\tpath2 = ''\n\telif len(tags) == 2:\n\t\tpath1 = tags[0]['path']\n\t\tpath2 = tags[1]['path']\n\t\n\tviewParams = {'path1': path1, 'path2': path2, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\tpopupTitle = self.view.params.title\n\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/card",
        "cursor": "pointer",
        "gap": "5px"
      }
    },
    "type": "ia.container.flex"
  }
}