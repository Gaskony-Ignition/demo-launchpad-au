{
  "custom": {
    "aggMode": "Maximum",
    "history": [],
    "tags": []
  },
  "params": {
    "aggMode": "Maximum",
    "path1": "",
    "path2": "",
    "title": "Title"
  },
  "propConfig": {
    "custom.aggMode": {
      "binding": {
        "config": {
          "path": "view.params.aggMode"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "config": {
          "aggregate": "MinMax",
          "avoidScanClassValidation": true,
          "dateRange": {
            "mostRecent": "24",
            "mostRecentUnits": "HOUR"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "polling": {
            "enabled": true,
            "rate": "30"
          },
          "preventInterpolation": false,
          "returnFormat": "Wide",
          "returnSize": {
            "delay": "1",
            "delayUnits": "HOUR",
            "type": "INTERVAL"
          },
          "tags": "{view.custom.tags}",
          "valueFormat": "DOCUMENT"
        },
        "transforms": [
          {
            "code": "\t# Timeseries chart expects 'time' rather than 't_stamp'.\n\tfor row in value:\n\t\trow['time'] = row.pop('t_stamp')\t\t\n\t\t\n\treturn value",
            "type": "script"
          }
        ],
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "aggMode": "{view.custom.aggMode}",
            "tagPath1": "{view.params.path1}",
            "tagPath2": "{view.params.path2}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn launchpad.views.lineChartTags(self, value)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.aggMode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path1": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path2": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 343,
      "width": 462
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/header"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "LabelInterval"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "text": "Aggregation:"
                },
                "type": "ia.display.label"
              },
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\t# Stop propagation to prevent opening the history popup when interacting with the dropdown.\n\tpass"
                      },
                      "scope": "G",
                      "stopPropagation": true,
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "AggModeSelect"
                },
                "position": {
                  "basis": "155px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "view.custom.aggMode"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "options": [
                    {
                      "label": "Average",
                      "value": "Average"
                    },
                    {
                      "label": "MinMax",
                      "value": "MinMax"
                    },
                    {
                      "label": "LastValue",
                      "value": "LastValue"
                    },
                    {
                      "label": "SimpleAverage",
                      "value": "SimpleAverage"
                    },
                    {
                      "label": "Sum",
                      "value": "Sum"
                    },
                    {
                      "label": "Minimum",
                      "value": "Minimum"
                    },
                    {
                      "label": "Maximum",
                      "value": "Maximum"
                    },
                    {
                      "label": "DurationOn",
                      "value": "DurationOn"
                    },
                    {
                      "label": "DurationOff",
                      "value": "DurationOff"
                    },
                    {
                      "label": "CountOn",
                      "value": "CountOn"
                    },
                    {
                      "label": "CountOff",
                      "value": "CountOff"
                    },
                    {
                      "label": "Count",
                      "value": "Count"
                    },
                    {
                      "label": "Range",
                      "value": "Range"
                    },
                    {
                      "label": "Variance",
                      "value": "Variance"
                    },
                    {
                      "label": "StdDev",
                      "value": "StdDev"
                    },
                    {
                      "label": "PctGood",
                      "value": "PctGood"
                    },
                    {
                      "label": "PctBad",
                      "value": "PctBad"
                    }
                  ],
                  "style": {
                    "classes": "launchpad/kpi/components/bar-chart/entry",
                    "width": "155px"
                  }
                },
                "type": "ia.input.dropdown"
              }
            ],
            "meta": {
              "name": "AggMode"
            },
            "props": {
              "style": {
                "gap": "10px"
              },
              "wrap": "wrap"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "TitleAndAgg"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "row-gap": "15px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "HistoryChart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.plots[0].trends[0].columns": {
            "binding": {
              "config": {
                "path": "view.custom.tags"
              },
              "transforms": [
                {
                  "code": "\treturn launchpad.views.lineChartTrendColumns(self, value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.series[0].data": {
            "binding": {
              "config": {
                "path": "view.custom.history"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "legend": {
            "visible": true
          },
          "plots": [
            {
              "axes": [],
              "markers": [],
              "relativeWeight": 1,
              "trends": [
                {
                  "axis": "",
                  "baselines": [],
                  "breakLine": true,
                  "interpolation": "curveLinear",
                  "radius": 2,
                  "series": "Data",
                  "stack": true,
                  "type": "line",
                  "visible": true
                }
              ]
            }
          ],
          "series": [
            {
              "name": "Data"
            }
          ],
          "timeRange": {
            "dateFormat": "DD/MM/YYYY",
            "timeFormat": "HH:mm:ss"
          },
          "xTrace": {
            "infoBox": {
              "dateFormat": "DD/MM/YYYY",
              "timeFormat": "HH:mm:ss"
            }
          },
          "timeAxis": {
            "tick": {
              "label": {
                "format": "HH:mm"
              }
            }
          }
        },
        "type": "ia.chart.timeseries"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tlaunchpad.views.lineChartOpenHistoryPopup(self, event)"
          },
          "scope": "G",
          "type": "script"
        },
        "onKeyDown": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tlaunchpad.views.lineChartOpenHistoryPopupOnKey(self, event)"
          }
        }
      }
    },
    "meta": {
      "name": "root",
      "tabIndex": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/card",
        "cursor": "pointer",
        "gap": "5px"
      }
    },
    "type": "ia.container.flex"
  }
}