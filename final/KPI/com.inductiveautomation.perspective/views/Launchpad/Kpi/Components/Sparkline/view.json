{
  "custom": {
    "documentation": "Placeholder",
    "format": "#,##0.#",
    "history": [
      {
        "Placeholder (TBD)": 0,
        "t_stamp": 1749673689691
      },
      {
        "Placeholder (TBD)": 0,
        "t_stamp": 1749674289691
      }
    ],
    "realtimePath": "[Launchpad]KPI/Placeholder",
    "sparklinePoints": [
      0,
      0
    ],
    "tagName": "Placeholder",
    "tags": [
      {
        "aggregate": "Average",
        "alias": "Placeholder (TBD)",
        "path": "[Launchpad]KPI/Placeholder"
      }
    ],
    "value": 0
  },
  "params": {
    "aggMode": "Average",
    "path": "[Launchpad]KPI/Placeholder"
  },
  "propConfig": {
    "custom.documentation": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}.Documentation"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}.FormatString"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "config": {
          "aggregate": "MinMax",
          "avoidScanClassValidation": true,
          "dateRange": {
            "mostRecent": "24",
            "mostRecentUnits": "HOUR"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "polling": {
            "enabled": true,
            "rate": "30"
          },
          "preventInterpolation": false,
          "returnFormat": "Wide",
          "returnSize": {
            "delay": "10",
            "delayUnits": "MIN",
            "type": "INTERVAL"
          },
          "tags": "{view.custom.tags}",
          "valueFormat": "DOCUMENT"
        },
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.realtimePath": {
      "binding": {
        "config": {
          "path": "view.params.path"
        },
        "transforms": [
          {
            "code": "\treturn launchpad.views.sparklineRealtimePath(self, value)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.sparklinePoints": {
      "binding": {
        "config": {
          "struct": {
            "history": "{view.custom.history}",
            "tag": "{view.custom.tags}"
          },
          "waitOnAll": true
        },
        "type": "expr-struct",
        "transforms": [
          {
            "code": "\treturn launchpad.views.sparklinePoints(self, value)",
            "type": "script"
          }
        ]
      },
      "persistent": true
    },
    "custom.tagName": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}.name"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "aggMode": "{view.params.aggMode}",
            "path": "{view.params.path}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn launchpad.views.sparklineTags(self, value)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.aggMode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 131,
      "width": 339
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "documentation": "{view.custom.documentation}",
                  "tagName": "{view.custom.tagName}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value['documentation']:\n\t\treturn value['documentation']\n\telse:\n\t\treturn value['tagName']",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/label",
            "textAlign": "left"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "CurrentValue"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberFormat({view.custom.value},{view.custom.format})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/number"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Units"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "realtimePath": "{view.custom.realtimePath}"
                    },
                    "tagPath": "{realtimePath}.engUnit"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/units"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "ValueAndUnits"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "column-gap": "10px",
            "row-gap": "0px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Trend"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "custom.range": {
            "binding": {
              "config": {
                "path": "view.custom.sparklinePoints"
              },
              "transforms": [
                {
                  "code": "\treturn launchpad.views.sparklineRange(self, value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.points": {
            "binding": {
              "config": {
                "path": "view.custom.sparklinePoints"
              },
              "type": "property"
            }
          },
          "props.range": {
            "binding": {
              "config": {
                "path": "this.custom.range"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "color": "var(--kpi-primary)",
          "marker": {
            "first": {
              "size": 0
            },
            "high": {
              "size": 0
            },
            "last": {
              "size": 0
            },
            "low": {
              "size": 0
            }
          },
          "style": {
            "marginTop": "6px"
          },
          "width": 2
        },
        "type": "ia.display.sparkline"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\tviewParams = {'path': self.view.custom.realtimePath, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\tpopupTitle = 'Historical Data'\n\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          },
          "scope": "G",
          "type": "script"
        },
        "onKeyDown": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tif event.key in ('Enter', ' '):\n\t\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\t\tviewParams = {'path': self.view.custom.realtimePath, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\t\tpopupTitle = 'Historical Data'\n\t\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          }
        }
      }
    },
    "meta": {
      "name": "root",
      "tabIndex": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/card-small",
        "cursor": "pointer",
        "gap": "0px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}