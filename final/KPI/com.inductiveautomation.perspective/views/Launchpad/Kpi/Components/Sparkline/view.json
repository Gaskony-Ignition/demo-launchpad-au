  "propConfig": {
    "custom.documentation": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}.Documentation"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}.FormatString"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "config": {
          "aggregate": "MinMax",
          "avoidScanClassValidation": true,
          "dateRange": {
            "mostRecent": "24",
            "mostRecentUnits": "HOUR"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "polling": {
            "enabled": true,
            "rate": "30"
          },
          "preventInterpolation": false,
          "returnFormat": "Wide",
          "returnSize": {
            "delay": "10",
            "delayUnits": "MIN",
            "type": "INTERVAL"
          },
          "tags": "{view.custom.tags}",
          "valueFormat": "DOCUMENT"
        },
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.realtimePath": {
      "binding": {
        "config": {
          "path": "view.params.path"
        },
        "transforms": [
          {
            "code": "\tdef getRealtimePath(historicalPath):\n\t\ttagDelim = \":/tag:\"\n\t\t\n\t\tparts = historicalPath.rsplit(tagDelim, 1)\n\t\t\n\t\textractedPath = \"\"\n\t\t\n\t\tif len(parts) > 1:\n\t\t\textractedPath = parts[1]\n\t\telse:\n\t\t\textractedPath = historicalPath\n\t\n\t\t# Default fallback.\n\t\tprovName = \"default\"\n\t\t\n\t\tif tagDelim in historicalPath:\n\t\t\tsegBeforeTagDelim = historicalPath.split(tagDelim, 1)[0]\n\t\t\tlastColonIndex = segBeforeTagDelim.rfind(\":\")\n\t\t\t\n\t\t\tif lastColonIndex != -1:\n\t\t\t\tprovName = segBeforeTagDelim[lastColonIndex + 1:]\n\t\t\telse:\n\t\t\t\tprovName = segBeforeTagDelim.rsplit(\":\", 1)[-1]\n\t\t\t\t\n\t\t\t\tif provName.startswith(\"histprov\"):\n\t\t\t\t\tprovName = provName.split(\":\", 1)[-1]\n\t\t\t\tif not provName:\n\t\t\t\t\tprovName = \"default\"\n\t\t\t\t\t\n\t\treturn \"[{}]{}\".format(provName, extractedPath)\n\t\n\treturn getRealtimePath(value) if \":/tag:\" in value else value",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.sparklinePoints": {
      "binding": {
        "config": {
          "struct": {
            "history": "{view.custom.history}",
            "tag": "{view.custom.tags}"
          },
          "waitOnAll": true
        },
        "type": "expr-struct",
        "transforms": [
          {
            "code": "\t# The struct above only gathers the pieces -- without this step props.points\n\t# receives the {history, tag} map itself, the component cannot coerce it, and\n\t# every tile silently keeps drawing this view's design-time placeholder.\n\thistory = value['history']\n\ttags = value['tag']\n\tif not history or not tags:\n\t\treturn []\n\t# Wide format keys each value column by the alias custom.tags built\n\tkey = tags[0]['alias']\n\trows = list(history)\n\ttry:\n\t\trows.sort(key = lambda r: r['t_stamp'])\n\texcept:\n\t\tpass\n\tpoints = []\n\tfor row in rows:\n\t\ttry:\n\t\t\tv = row[key]\n\t\texcept:\n\t\t\tcontinue\n\t\t# depending on how the binding serialises, a cell can arrive as the bare\n\t\t# number or as the qualified value that carries it\n\t\tif hasattr(v, 'value'):\n\t\t\tv = v.value\n\t\telif isinstance(v, dict):\n\t\t\tv = v.get('value')\n\t\tif v is None:\n\t\t\tcontinue\n\t\ttry:\n\t\t\tpoints.append(float(v))\n\t\texcept:\n\t\t\tcontinue\n\treturn points",
            "type": "script"
          }
        ]
      },
      "persistent": true
    },
    "custom.tagName": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}.name"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "aggMode": "{view.params.aggMode}",
            "path": "{view.params.path}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tdef getTagName(tagPath):\n\t\t# Get name from Documentation of tag.\n\t\ttagName = system.tag.read('{tagPath}.Documentation'.format(tagPath = tagPath)).value\n\t\t\n\t\tif not tagName:\n\t\t\t# No name found in Documentation. Use tag name instead.\n\t\t\tsplitByProv = tagPath.split(']')\n\t\t\tpathNoProv = splitByProv[len(splitByProv) - 1]\n\t\n\t\t\t# Now, get the tag name.\n\t\t\tsplitByForwardSlash = pathNoProv.split('/')\n\t\t\ttagName = splitByForwardSlash[len(splitByForwardSlash) - 1]\n\t\t\t\n\t\t# Get the eng units of tag.\n\t\tengUnit = system.tag.read('{tagPath}.engUnit'.format(tagPath = tagPath)).value\n\t\t\n\t\tif engUnit:\n\t\t\treturn '{tagName} ({engUnit})'.format(tagName = tagName, engUnit = engUnit)\n\t\telse:\n\t\t\treturn tagName\n\t\t\t\n\tdef getRealtimePath(historicalPath):\n\t\ttag = \":/tag:\"\n\t\n\t\tparts = historicalPath.rsplit(tag, 1)\n\t\n\t\tif len(parts) > 1:\n\t\t    result = parts[1]\n\t\telse:\n\t\t    result = historicalPath\n\t\t\n\t\treturn result\t\n\t\n\ttagPath = value[\"path\"]\n\t\n\tif tagPath:\n\t\trealtimePath = getRealtimePath(tagPath)\n\t\t\n\t\treturn [{\"path\": tagPath, \"alias\": getTagName(realtimePath), \"aggregate\": value[\"aggMode\"]}]\n\telse:\n\t\treturn []",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "realtimePath": "{view.custom.realtimePath}"
          },
          "tagPath": "{realtimePath}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.aggMode": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 131,
      "width": 339
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "documentation": "{view.custom.documentation}",
                  "tagName": "{view.custom.tagName}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value['documentation']:\n\t\treturn value['documentation']\n\telse:\n\t\treturn value['tagName']",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/label",
            "textAlign": "left"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "CurrentValue"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "numberFormat({view.custom.value},{view.custom.format})"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/number"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Units"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "realtimePath": "{view.custom.realtimePath}"
                    },
                    "tagPath": "{realtimePath}.engUnit"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/units"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "ValueAndUnits"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "column-gap": "10px",
            "row-gap": "0px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Sparkline"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "custom.range": {
            "binding": {
              "config": {
                "path": "view.custom.sparklinePoints"
              },
              "transforms": [
                {
                  "code": "\tif not value:\n\t\treturn {'low': '', 'high': ''}\n\tminVal = min(value)\n\tmaxVal = max(value)\n\tif minVal != maxVal:\n\t\treturn {'low': minVal, 'high': maxVal}\n\t# a dead-flat series has no range of its own; give it room either side so the\n\t# line lands mid-tile instead of on an edge\n\treturn {'low': minVal * 0.50, 'high': maxVal * 1.50}",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.points": {
            "binding": {
              "config": {
                "path": "view.custom.sparklinePoints"
              },
              "type": "property"
            }
          },
          "props.range": {
            "binding": {
              "config": {
                "path": "this.custom.range"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "color": "var(--kpi-primary)",
          "marker": {
            "first": {
              "size": 0
            },
            "high": {
              "size": 0
            },
            "last": {
              "size": 0
            },
            "low": {
              "size": 0
            }
          },
          "style": {
            "marginTop": "6px"
          },
          "width": 2
        },
        "type": "ia.display.sparkline"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\tviewParams = {'path': self.view.custom.realtimePath, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\tpopupTitle = 'Historical Data'\n\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          },
          "scope": "G",
          "type": "script"
        },
        "onKeyDown": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tif event.key in ('Enter', ' '):\n\t\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\t\tviewParams = {'path': self.view.custom.realtimePath, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\t\tpopupTitle = 'Historical Data'\n\t\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          }
        }
      }
    },
    "meta": {
      "name": "root",
      "tabIndex": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/card-small",
        "cursor": "pointer",
        "gap": "0px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}