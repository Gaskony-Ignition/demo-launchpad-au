{
  "custom": {
    "format": "#,##0.#",
    "label": "Placeholder",
    "popupName": "Placeholder - [Launchpad]KPI/Placeholder",
    "units": "TBD",
    "value": 50
  },
  "params": {
    "path": "[Launchpad]KPI/Placeholder"
  },
  "propConfig": {
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.FormatString"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.Documentation"
        },
        "transforms": [
          {
            "code": "\tif value == '':\n\t\treturn self.params.path.split('/')[-1]\n\telse:\n\t\treturn value",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.popupName": {
      "binding": {
        "config": {
          "expression": "{view.custom.label} + ' - ' + {view.params.path}"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.units": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngUnit"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 422,
      "width": 432
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "34px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "numberFormat({view.custom.value},{view.custom.format})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/number"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Units"
        },
        "position": {
          "basis": "24px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.units"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/units",
            "marginTop": 2
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "26px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/label",
            "marginTop": 4
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\tviewParams = {'path': self.view.params.path, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\tpopupTitle = self.view.custom.popupName\n\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          },
          "scope": "G",
          "type": "script"
        },
        "onKeyDown": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tif event.key in ('Enter', ' '):\n\t\tviewPath = 'Launchpad/Kpi/EmbeddedViews/Popup'\n\t\tviewParams = {'path': self.view.params.path, 'historyProvider': self.session.custom.launchpad.historyProvider}\n\t\tpopupTitle = self.view.custom.popupName\n\t\tlaunchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          }
        }
      }
    },
    "meta": {
      "name": "root",
      "tabIndex": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/card-small",
        "cursor": "pointer",
        "overflow": "hidden",
        "overflowX": "hidden",
        "overflowY": "hidden",
        "padding": 6
      }
    },
    "type": "ia.container.flex"
  }
}