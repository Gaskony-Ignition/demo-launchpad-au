      }
    },
    "custom.realtime.startDate": {
      "binding": {
        "config": {
          "expression": "addDays({view.custom.realtime.endDate}, -{view.custom.realtime.days})"
        },
        "type": "expr"
      }
    },
    "custom.startDate": {
      "binding": {
        "config": {
          "expression": "addHours(now(0), -24)"
        },
        "type": "expr"
      },
      "persistent": true
