  "propConfig": {
    "custom.aggMode": {
      "binding": {
        "config": {
          "path": "view.params.aggMode"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.endDate": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "config": {
          "struct": {
            "aggMode": "{view.custom.aggMode}",
            "endDate": "{view.custom.endDate}",
            "interval": "{view.custom.interval}",
            "mode": "{view.custom.mode}",
            "realtime": "{view.custom.realtime}",
            "startDate": "{view.custom.startDate}",
            "tags": "{view.custom.tags}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value.get('mode') == 'Historical':\n\t\tstartDate = value.get('startDate')\n\t\tendDate = value.get('endDate')\n\telse:\n\t\tstartDate = value.get('realtime').get('startDate')\n\t\tendDate = value.get('realtime').get('endDate')\n\t\n\ttagPaths = []\n\tcolumnNames = []\n\t\n\tfor tag in value['tags']:\n\t\ttagPaths.append(tag['path'])\n\t\tcolumnNames.append(tag['alias'])\n\t\t\n\tres = system.tag.queryTagHistory(paths = tagPaths, aggregationMode = value['aggMode'], columnNames = columnNames, startDate = startDate, endDate = endDate, intervalMinutes = value.get('interval'))\n\tresColNames = system.dataset.getColumnHeaders(res)\n\t\n\tdata = []\n\n\tfor x in range(0, res.getRowCount()):\n\t\tnewRow = {'blank': 0}\n\t\tfor resColName in resColNames:\n\t\t\tval = res.getValueAt(x, resColName)\n\t\t\tnewRow[resColName] = val\n\t\t\t\n\t\tdata.append(newRow)\n\t\t\n\treturn data",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.interval": {
      "persistent": true
    },
    "custom.mode": {
      "persistent": true
    },
    "custom.realtime": {
      "persistent": true
    },
    "custom.realtime.endDate": {
      "binding": {
        "config": {
          "expression": "now(30000)"
        },
        "type": "expr"
      }
    },
    "custom.realtime.startDate": {
      "binding": {
        "config": {
          "expression": "addDays({view.custom.realtime.endDate}, -{view.custom.realtime.days})"
        },
        "type": "expr"
      }
    },
    "custom.startDate": {
      "binding": {
        "config": {
          "expression": "addHours(now(0), -24)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "tagPath1": "{view.params.path1}",
            "tagPath2": "{view.params.path2}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tdef getTagName(tagPath):\n\t\t# Get name from Documentation of tag.\n\t\ttagName = system.tag.read('{tagPath}.Documentation'.format(tagPath = tagPath)).value\n\t\t\n\t\tif not tagName:\n\t\t\t# No name found in Documentation. Use tag name instead.\n\t\t\ttagName = system.tag.read('{tagPath}.name'.format(tagPath = tagPath)).value\n\t\t\t\n\t\t# Get the eng units of tag.\n\t\tengUnit = system.tag.read('{tagPath}.engUnit'.format(tagPath = tagPath)).value\n\t\t\n\t\tif engUnit:\n\t\t\treturn '{tagName} ({engUnit})'.format(tagName = tagName, engUnit = engUnit)\n\t\telse:\n\t\t\treturn tagName\n\t\t\t\n\tdef getRealtimePath(historicalPath):\n\t\ttagDelim = \":/tag:\"\n\t\t\n\t\tparts = historicalPath.rsplit(tagDelim, 1)\n\t\t\n\t\textractedPath = \"\"\n\t\t\n\t\tif len(parts) > 1:\n\t\t\textractedPath = parts[1]\n\t\telse:\n\t\t\textractedPath = historicalPath\n\t\n\t\t# Default fallback.\n\t\tprovName = \"default\"\n\t\t\n\t\tif tagDelim in historicalPath:\n\t\t\tsegBeforeTagDelim = historicalPath.split(tagDelim, 1)[0]\n\t\t\tlastColonIndex = segBeforeTagDelim.rfind(\":\")\n\t\t\t\n\t\t\tif lastColonIndex != -1:\n\t\t\t\tprovName = segBeforeTagDelim[lastColonIndex + 1:]\n\t\t\telse:\n\t\t\t\tprovName = segBeforeTagDelim.rsplit(\":\", 1)[-1]\n\t\t\t\t\n\t\t\t\tif provName.startswith(\"histprov\"):\n\t\t\t\t\tprovName = provName.split(\":\", 1)[-1]\n\t\t\t\tif not provName:\n\t\t\t\t\tprovName = \"default\"\n\t\t\t\t\t\n\t\treturn \"[{}]{}\".format(provName, extractedPath)\n\t\n\ttags = []\n\t\n\ttagPath1 = value.get('tagPath1')\n\ttagPath2 = value.get('tagPath2')\n\t\n\trealtimePath1 = getRealtimePath(tagPath1) if \":/tag:\" in tagPath1 else tagPath1\n\trealtimePath2 = getRealtimePath(tagPath2) if \":/tag:\" in tagPath2 else tagPath2\n\t\n\tif tagPath1:\n\t\ttags.append({\"alias\": getTagName(realtimePath1), \"path\": realtimePath1})\n\t\t\n\tif tagPath2:\n\t\ttags.append({\"alias\": getTagName(realtimePath2), \"path\": realtimePath2})\n\t\t\n\treturn tags",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
