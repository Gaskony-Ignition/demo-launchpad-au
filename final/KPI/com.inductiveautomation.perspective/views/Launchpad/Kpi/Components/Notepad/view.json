{
  "custom": {},
  "params": {
    "path": "[Launchpad]KPI/Notepad"
  },
  "propConfig": {
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 200,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "text": "Notepad:"
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\n\tif self.parent.parent.getChild(\"TextArea\").props.enabled:\n\t\tself.parent.parent.getChild(\"TextArea\").props.enabled = False\n\telse:\n\t\tself.parent.parent.getChild(\"TextArea\").props.enabled = True"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onKeyDown": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif event.key in ('Enter', ' '):\n\t\n\t\tif self.parent.parent.getChild(\"TextArea\").props.enabled:\n\t\t\tself.parent.parent.getChild(\"TextArea\").props.enabled = False\n\t\telse:\n\t\t\tself.parent.parent.getChild(\"TextArea\").props.enabled = True"
                  }
                }
              }
            },
            "meta": {
              "name": "Icon",
              "tooltip": {
                "enabled": true,
                "text": "Toggle editing of the note"
              },
              "tabIndex": 0
            },
            "position": {
              "basis": "30px"
            },
            "props": {
              "path": "material/edit",
              "style": {
                "classes": ""
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0,
          "basis": "26px"
        },
        "props": {
          "style": {
            "classes": "launchpad/kpi/text/subheader"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "TextArea"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "bidirectional": true,
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "path": "{view.params.path}"
                },
                "tagPath": "{path}"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "rejectUpdatesWhileFocused": false,
          "style": {
            "backgroundColor": "transparent",
            "borderStyle": "none",
            "marginTop": 10,
            "minHeight": 64
          },
          "enabled": false
        },
        "type": "ia.input.text-area"
      }
    ],
    "meta": {
      "name": "root",
      "tabIndex": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/card"
      }
    },
    "type": "ia.container.flex"
  }
}