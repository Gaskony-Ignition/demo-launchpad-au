{
  "custom": {
    "setupResult": "Press Check to see what is already in place.",
    "maintResult": ""
  },
  "params": {},
  "props": {
    "defaultSize": {
      "height": 600,
      "width": 800
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex",
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/kpi/root",
        "margin": 20
      }
    },
    "children": [
      {
        "meta": {
          "name": "GatewaySetup"
        },
        "position": {
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "launchpad/kpi/card"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "Header"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "Gateway setup",
              "style": {
                "classes": "launchpad/kpi/text/label",
                "fontSize": 20,
                "marginBottom": 6,
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Info"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "Creates the KPI database, the launchpad tag provider and historian, the simulator device and its programme, the KPI tags, the dashboard tables and 48 hours of history. Safe to press twice: it only creates what is missing.",
              "style": {
                "classes": "launchpad/kpi/text/label",
                "marginBottom": 14,
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Buttons"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center"
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "SetUp"
                },
                "position": {
                  "basis": "190px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tlaunchpad.views.settingsRunSetup(self, event)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "text": "Set up this gateway",
                  "style": {
                    "classes": "launchpad/kpi/header/button-selected",
                    "marginRight": 10
                  }
                },
                "type": "ia.input.button"
              },
              {
                "meta": {
                  "name": "Check"
                },
                "position": {
                  "basis": "120px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tlaunchpad.views.settingsCheckSetup(self, event)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "text": "Check",
                  "style": {
                    "classes": "launchpad/kpi/header/button-selected",
                    "marginRight": 10
                  }
                },
                "type": "ia.input.button"
              },
              {
                "meta": {
                  "name": "UpdateTags"
                },
                "position": {
                  "basis": "150px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tlaunchpad.views.settingsUpdateTags(self, event)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "text": "Update tags",
                  "style": {
                    "classes": "launchpad/kpi/header/button-selected",
                    "marginRight": 10
                  }
                },
                "type": "ia.input.button"
              }
            ]
          },
          {
            "meta": {
              "name": "Result"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.setupResult"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/label",
                "textAlign": "left",
                "whiteSpace": "pre-line",
                "marginTop": 14
              }
            },
            "type": "ia.display.label"
          }
        ]
      },
      {
        "meta": {
          "name": "Appearance"
        },
        "position": {
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "launchpad/kpi/card"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "Header"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "Appearance",
              "style": {
                "classes": "launchpad/kpi/text/label",
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Info"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "Repaints this session only. Ignition's six themes are always listed; any custom theme installed on this gateway follows them. To change what everyone gets, set the project's theme in the Designer.",
              "style": {
                "classes": "launchpad/kpi/text/label",
                "textAlign": "left",
                "marginBottom": 10
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Row"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center"
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "ThemeLabel"
                },
                "position": {
                  "basis": "60px",
                  "shrink": 0
                },
                "props": {
                  "text": "Theme",
                  "style": {
                    "classes": "launchpad/kpi/text/label",
                    "textAlign": "left"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Theme"
                },
                "position": {
                  "basis": "260px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.options": {
                    "binding": {
                      "config": {
                        "struct": {}
                      },
                      "transforms": [
                        {
                          "code": "\treturn launchpad.ui.themeOptions()",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "session.props.theme"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "launchpad/kpi/control/dropdown"
                  }
                },
                "type": "ia.input.dropdown"
              }
            ]
          }
        ]
      },
      {
        "meta": {
          "name": "Maintenance"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "launchpad/kpi/card"
          }
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "Header"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "History maintenance",
              "style": {
                "classes": "launchpad/kpi/text/label",
                "fontSize": 20,
                "marginBottom": 6,
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Info"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "Setup seeds history once and then leaves it alone. These two are for afterwards: re-seed discards the seeded samples and writes them again, which is what you want after rescaling a tag; repair moves mis-columned integer samples into the column an integer tag actually reads.",
              "style": {
                "classes": "launchpad/kpi/text/label",
                "marginBottom": 14,
                "textAlign": "left"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Buttons"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center"
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": {
                  "name": "Reseed"
                },
                "position": {
                  "basis": "170px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tlaunchpad.views.settingsReseedHistory(self, event)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "text": "Re-seed history",
                  "style": {
                    "classes": "launchpad/kpi/header/button-selected",
                    "marginRight": 10
                  }
                },
                "type": "ia.input.button"
              },
              {
                "meta": {
                  "name": "Repair"
                },
                "position": {
                  "basis": "160px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t# moves mis-columned integer samples into intvalue, where an int tag reads them\n\tview = self.view\n\tview.custom.maintResult = \"repairing...\"\n\tdef work():\n\t\tview.custom.maintResult = \"repaired: %s\" % launchpad.init.repairBackfill()\n\tsystem.util.invokeAsynchronous(work)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "props": {
                  "text": "Repair columns",
                  "style": {
                    "classes": "launchpad/kpi/header/button-selected",
                    "marginRight": 10
                  }
                },
                "type": "ia.input.button"
              }
            ]
          },
          {
            "meta": {
              "name": "Result"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.maintResult"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/kpi/text/label",
                "textAlign": "left",
                "whiteSpace": "pre-line",
                "marginTop": 14
              }
            },
            "type": "ia.display.label"
          }
        ]
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tsystem.perspective.sendMessage(\"navigation\", \"Settings\")"
          },
          "scope": "G",
          "type": "script"
        }
      }
    }
  }
}