{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "Tags"
        },
        "position": {
          "basis": "400px"
        },
        "type": "ia.display.tag-browse-tree"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tlaunchpad.views.tagSetupExportPds(self, event)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "ExportPds"
        },
        "position": {
          "basis": "34px"
        },
        "props": {
          "text": "Export PDS"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tlaunchpad.views.tagSetupPointOpc(self, event)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "PointOpc"
        },
        "position": {
          "basis": "34px"
        },
        "props": {
          "text": "Point OPC to PDS"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}