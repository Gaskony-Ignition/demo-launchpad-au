{
  "custom": {
    "shiftEnabled": null,
    "shiftStart": null,
    "shiftStop": null
  },
  "params": {
    "lineName": "Line1",
    "linePath": "[Launchpad]OEE/Demo",
    "shift": 1
  },
  "propConfig": {
    "custom.shiftEnabled": {
      "binding": {
        "config": {
          "bidirectional": true,
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.linePath}",
            "2": "{view.params.lineName}",
            "3": "{view.params.shift}"
          },
          "tagPath": "{1}/{2}/Schedule/{3}/ShiftEnabled"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.shiftStart": {
      "binding": {
        "config": {
          "bidirectional": true,
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.linePath}",
            "2": "{view.params.lineName}",
            "3": "{view.params.shift}"
          },
          "tagPath": "{1}/{2}/Schedule/{3}/StartTime"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.shiftStop": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.linePath}",
            "2": "{view.params.lineName}",
            "3": "{view.params.shift}"
          },
          "tagPath": "{1}/{2}/Schedule/{3}/StopTime"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.lineName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.linePath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.shift": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 46,
      "width": 415
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "ShftEnabled"
        },
        "position": {
          "basis": "107px"
        },
        "propConfig": {
          "props.selected": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.custom.shiftEnabled"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "\"Shift \" + {view.params.shift}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/oee/text/label"
          },
          "uncheckedIcon": {
            "style": {
              "borderBottomLeftRadius": "2px",
              "borderBottomRightRadius": "2p",
              "borderTopLeftRadius": "2px",
              "borderTopRightRadius": "2px"
            }
          }
        },
        "type": "ia.input.checkbox"
      },
      {
        "meta": {
          "name": "StartLabel"
        },
        "position": {
          "basis": "50px"
        },
        "props": {
          "style": {
            "classes": "launchpad/oee/text/label",
            "textAlign": "center"
          },
          "text": "Start"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "ShiftStart"
        },
        "position": {
          "basis": "100px"
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.params.linePath} + \"/\" + {view.params.lineName} + \"/Schedule/\" + {view.params.shift} + \"/StartTime\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "Launchpad/Oee/Components/TimePicker",
          "style": {
            "marginBottom": 2,
            "marginTop": 2
          }
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "StopLabel"
        },
        "position": {
          "basis": "50px"
        },
        "props": {
          "style": {
            "classes": "launchpad/oee/text/label",
            "textAlign": "center"
          },
          "text": "Stop"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "ShiftStop"
        },
        "position": {
          "basis": "100px"
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.params.linePath} + \"/\" + {view.params.lineName} + \"/Schedule/\" + {view.params.shift} + \"/StopTime\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "Launchpad/Oee/Components/TimePicker",
          "style": {
            "marginBottom": 2,
            "marginTop": 2
          }
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "overflow": "hidden"
      },
      "wrap": "wrap"
    },
    "type": "ia.container.flex"
  }
}