{
  "custom": {
    "mode": "Historical"
  },
  "params": {},
  "propConfig": {
    "custom.mode": {
      "binding": {
        "config": {
          "bidirectional": true,
          "path": "session.custom.launchpad.oee.display.mode"
        },
        "type": "property"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 900
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tself.view.custom.mode = self.meta.name\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Realtime"
        },
        "position": {
          "basis": "100px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.custom.mode}={this.meta.name}, \"launchpad/oee/control/button-selected\", \"launchpad/oee/control/button-unselected\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "marginRight": "8px"
          },
          "text": "Realtime"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tself.view.custom.mode  = self.meta.name"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Historical"
        },
        "position": {
          "basis": "100px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.custom.mode}={this.meta.name}, \"launchpad/oee/control/button-selected\", \"launchpad/oee/control/button-unselected\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {},
          "text": "Historical"
        },
        "type": "ia.input.button"
      },
      {
        "children": [
          {
            "meta": {
              "name": "SelectionLabel"
            },
            "position": {
              "basis": "75px"
            },
            "props": {
              "style": {
                "classes": "launchpad/oee/text/label",
                "marginLeft": "8px"
              },
              "text": "Interval"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Interval"
            },
            "position": {
              "basis": "100px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "session.custom.launchpad.oee.display.interval"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "options": [
                {
                  "label": "Day",
                  "value": "Day"
                },
                {
                  "label": "Shift",
                  "value": "Shift"
                },
                {
                  "label": "Hour",
                  "value": "Hour"
                }
              ],
              "style": {
                "marginLeft": "8px"
              }
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "name": "RealtimeOptions"
        },
        "position": {
          "basis": "175px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.mode}= \"Realtime\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "RangeLabel"
            },
            "position": {
              "basis": "75px",
              "shrink": 0.6
            },
            "props": {
              "style": {
                "classes": "launchpad/oee/text/label",
                "marginRight": "8px"
              },
              "text": "Period"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "RangeDropdown"
            },
            "position": {
              "basis": "130px",
              "shrink": 0
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "session.custom.launchpad.oee.display.rangeDays.period"
                  },
                  "type": "property"
                },
                "onChange": {
                  "enabled": null,
                  "script": "\tlaunchpad.views.lineDisplayOptionsRangeChanged(self, previousValue, currentValue, origin, missedEvents)"
                }
              }
            },
            "props": {
              "options": [
                {
                  "label": "Yesterday",
                  "value": 0
                },
                {
                  "label": "This Week",
                  "value": 1
                },
                {
                  "label": "Last Week",
                  "value": 2
                },
                {
                  "label": "This Month",
                  "value": 3
                },
                {
                  "label": "Last Month",
                  "value": 4
                },
                {
                  "label": "Last 30 Days",
                  "value": 5
                },
                {
                  "label": "This Quarter",
                  "value": 6
                },
                {
                  "label": "Last Quarter",
                  "value": 7
                },
                {
                  "label": "Year To Date",
                  "value": 8
                },
                {
                  "label": "Last 365 Days",
                  "value": 9
                }
              ],
              "style": {
                "classes": "launchpad/oee/control/dropdown",
                "marginRight": "8px"
              }
            },
            "type": "ia.input.dropdown"
          },
          {
            "meta": {
              "name": "StartDate"
            },
            "position": {
              "basis": "150px"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.mode"
                  },
                  "transforms": [
                    {
                      "fallback": true,
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": "Realtime",
                          "output": false
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.inputProps.style.backgroundColor": {
                "binding": {
                  "config": {
                    "path": "this.props.enabled"
                  },
                  "transforms": [
                    {
                      "fallback": "var(--oee-object)",
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "var(--oee-card)"
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "session.custom.launchpad.oee.display.customTime.start"
                  },
                  "type": "property"
                },
                "onChange": {
                  "enabled": null,
                  "script": "\n\t# if user changed date/time, clear dropdown\n\tif origin == \"Browser\":\n\t\tself.getSibling(\"RangeDropdown\").props.value = \"\""
                }
              }
            },
            "props": {
              "format": "DD/MM/YYYY",
              "formattedValue": "Jul, 16 2025",
              "inputProps": {
                "style": {
                  "classes": "launchpad/oee/control/text-entry",
                  "color": "var(--oee-ink-strong)"
                }
              },
              "style": {
                "marginRight": "8px"
              }
            },
            "type": "ia.input.date-time-input"
          },
          {
            "meta": {
              "name": "ToLabel"
            },
            "position": {
              "basis": "35px"
            },
            "props": {
              "style": {
                "classes": "launchpad/oee/text/label",
                "marginRight": "8px"
              },
              "text": "To"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "StopDate"
            },
            "position": {
              "basis": "150px"
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.mode"
                  },
                  "transforms": [
                    {
                      "fallback": true,
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": "Realtime",
                          "output": false
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.inputProps.style.backgroundColor": {
                "binding": {
                  "config": {
                    "path": "this.props.enabled"
                  },
                  "transforms": [
                    {
                      "fallback": "var(--oee-object)",
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "var(--oee-card)"
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "session.custom.launchpad.oee.display.customTime.stop"
                  },
                  "type": "property"
                },
                "onChange": {
                  "enabled": null,
                  "script": "\t\n\t# if user changed date/time, clear dropdown\n\tif origin == \"Browser\":\n\t\tself.getSibling(\"RangeDropdown\").props.value = \"\""
                }
              }
            },
            "props": {
              "format": "DD/MM/YYYY",
              "formattedValue": "Jul 16, 2025",
              "inputProps": {
                "style": {
                  "classes": "launchpad/oee/control/text-entry",
                  "color": "var(--oee-ink-strong)"
                }
              },
              "style": {
                "marginRight": "8px"
              }
            },
            "type": "ia.input.date-time-input"
          }
        ],
        "meta": {
          "name": "HistoricalOptions"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.mode}= \"Historical\"  "
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "launchpad/oee/card-small"
      },
      "wrap": "nowrap"
    },
    "type": "ia.container.flex"
  }
}
