{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 420,
      "width": 560
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "35px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "launchpad/oee/text/header",
            "marginBottom": "10px"
          },
          "text": "Project Settings"
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "basis": "90px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "launchpad/oee/text/label",
                    "textAlign": "left"
                  },
                  "text": "Database Connection"
                },
                "type": "ia.display.label",
                "children": []
              },
              {
                "meta": {
                  "name": "DatabaseConnection"
                },
                "position": {
                  "basis": "175px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "now(0)"
                      },
                      "transforms": [
                        {
                          "code": "\treturn launchpad.oee.db()",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "enabled": false,
                  "style": {
                    "classes": "launchpad/oee/control/text-entry-dark",
                    "marginBottom": 5,
                    "marginTop": 5
                  }
                },
                "type": "ia.input.text-field",
                "children": []
              }
            ],
            "meta": {
              "name": "Settings"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "wrap": "wrap"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "DatabaseInit"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "justify": "space-between",
          "style": {
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "basis": "90px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "launchpad/oee/text/label",
                    "textAlign": "start"
                  },
                  "text": "Base Tag Folder"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "LineTagFolder"
                },
                "position": {
                  "grow": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "session.custom.launchpad.oee.lineTagFolder"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "enabled": false,
                  "style": {
                    "classes": "launchpad/oee/control/text-entry-dark",
                    "marginBottom": 5,
                    "marginTop": 5
                  }
                },
                "type": "ia.input.text-field"
              }
            ],
            "meta": {
              "name": "Settings"
            },
            "position": {
              "basis": "50px",
              "grow": 1,
              "shrink": 0
            },
            "props": {
              "style": {
                "overflow": "visible"
              },
              "wrap": "wrap"
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Info"
            },
            "position": {
              "grow": 1,
              "shrink": 0
            },
            "props": {
              "alignVertical": "top",
              "style": {
                "classes": "launchpad/oee/text/label"
              },
              "text": "All line UDT instances should all be in one folder.  Provide the path to the folder in order to get the list of all line names.",
              "textStyle": {
                "marginLeft": "20px",
                "textAlign": "start"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "TagFolder"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "overflow": "visible"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "basis": "100px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "launchpad/oee/text/label"
                  },
                  "text": "OEE Target"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Slider"
                },
                "position": {
                  "basis": "300px"
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "session.custom.launchpad.oee.target"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "labels": {
                    "interval": 0.05
                  },
                  "max": 1,
                  "step": 0.01
                },
                "type": "ia.input.slider"
              },
              {
                "meta": {
                  "name": "LedDisplay"
                },
                "position": {
                  "basis": "50px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "path": "session.custom.launchpad.oee.target"
                      },
                      "transforms": [
                        {
                          "code": "\treturn str(value*100).split(\".\")[0] + \"%\"",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "backgroundColor": "var(--oee-card)",
                  "diodeOnColor": "var(--oee-good)"
                },
                "type": "ia.display.led-display"
              }
            ],
            "meta": {
              "name": "OeeTarget"
            },
            "position": {
              "basis": "70px"
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Info"
            },
            "props": {
              "markdown": {
                "escapeHtml": false
              },
              "source": "Adjust this value for the \"good\" OEE value you are targeting.\n\nAll displays of the OEE value that change color will show as red if below this value, and green if above it.\n\nThis is not stored historically, it is only used for the live display of colors.",
              "style": {
                "classes": "launchpad/oee/text/label",
                "marginLeft": 20,
                "textAlign": "start"
              }
            },
            "type": "ia.display.markdown"
          }
        ],
        "meta": {
          "name": "OeeTargetFlex"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "grow": 1,
      "shrink": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/oee/card"
      }
    },
    "type": "ia.container.flex"
  }
}