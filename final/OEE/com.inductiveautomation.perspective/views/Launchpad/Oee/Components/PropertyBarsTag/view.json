{
  "custom": {
    "instances": [
      {
        "path": "[Launchpad]OEE/Demo/Line 1/ShiftOee/O",
        "title": "Line 1"
      },
      {
        "path": "[Launchpad]OEE/Demo/Line 2/ShiftOee/O",
        "title": "Line 2"
      },
      {
        "path": "[Launchpad]OEE/Demo/Line 3/ShiftOee/O",
        "title": "Line 3"
      },
      {
        "path": "[Launchpad]OEE/Demo/Line 4/ShiftOee/O",
        "title": "Line 4"
      },
      {
        "path": "[Launchpad]OEE/Demo/Line 5/ShiftOee/O",
        "title": "Line 5"
      },
      {
        "path": "[Launchpad]OEE/Demo/Line 6/ShiftOee/O",
        "title": "Line 6"
      },
      {
        "path": "[Launchpad]OEE/Demo/Line 7/ShiftOee/O",
        "title": "Line 7"
      }
    ]
  },
  "params": {
    "folderPath": "[Launchpad]OEE/Demo",
    "property": "ShiftOee/O",
    "title": ""
  },
  "propConfig": {
    "custom.instances": {
      "binding": {
        "config": {
          "struct": {
            "lines": "{session.custom.launchpad.oee.lines}",
            "path": "{view.params.folderPath}",
            "property": "{view.params.property}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tinstances = []\n\tfor item in value.lines:\n\t\tinstances.append({'path':value.path + \"/\" + item + \"/\" + value.property, \"title\": item})\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.folderPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.property": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 694,
      "width": 491
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "this.props.text"
              },
              "transforms": [
                {
                  "fallback": true,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "",
                      "output": false
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/oee/text/header",
            "marginBottom": 4
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "basis": "154px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.instances"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "26px",
            "shrink": 0
          },
          "elementStyle": {
            "margin": 0,
            "padding": 2
          },
          "path": "Launchpad/Oee/Components/ProgressBarTag",
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root",
      "tabIndex": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/oee/card"
      }
    },
    "type": "ia.container.flex"
  }
}