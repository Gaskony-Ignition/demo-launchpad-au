{
  "custom": {
    "value": 830
  },
  "params": {
    "tagPath": "[Launchpad]OEE/Demo/Line 3/Schedule/1/StartTime"
  },
  "propConfig": {
    "custom.value": {
      "binding": {
        "config": {
          "bidirectional": true,
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.params.tagPath}"
          },
          "tagPath": "{1}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 41,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tself.view.custom.value \u003d self.props.value*100 + self.getSibling(\"Minutes\").props.value\n\t\n\t\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Hours"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "path": "view.custom.value"
              },
              "transforms": [
                {
                  "expression": "floor({value}/100)\t",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "inputBounds": {
            "maximum": 23,
            "minimum": 0
          },
          "style": {
            "classes": "launchpad/oee/control/text-entry-dark"
          }
        },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tself.view.custom.value \u003d self.getSibling(\"Hours\").props.value*100 + self.props.value"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Minutes"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "path": "view.custom.value"
              },
              "transforms": [
                {
                  "expression": "{value}%100\t",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "format": "00",
          "inputBounds": {
            "maximum": 59,
            "minimum": 0
          },
          "style": {
            "classes": "launchpad/oee/control/text-entry-dark"
          }
        },
        "type": "ia.input.numeric-entry-field"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "launchpad/oee/root"
      }
    },
    "type": "ia.container.flex"
  }
}