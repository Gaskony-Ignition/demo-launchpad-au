{
  "custom": {
    "background": "linear-gradient(to right,var(--oee-highlight) 71.0%, var(--oee-gray-q) 0%)",
    "format": "#0.0%",
    "value": 0.71
  },
  "params": {
    "color": "var(--oee-highlight)",
    "value": 0.71
  },
  "propConfig": {
    "custom.background": {
      "binding": {
        "config": {
          "struct": {
            "color": "{view.params.color}",
            "target": "{session.custom.launchpad.oee.target}",
            "value": "{view.custom.value}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tcolor \u003d value.color\n\tif value.value \u003c value.target:\n\t\tcolor \u003d \u0027var(--oee-bad)\u0027\n\t\n\treturn \u0027linear-gradient(to right,%s %s%%, var(--oee-gray-q) 0%%)\u0027 % (color, value.value*100.0)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.FormatString"
        },
        "enabled": false,
        "type": "tag"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "propConfig": {
          "props.style.background": {
            "binding": {
              "config": {
                "path": "view.custom.background"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "numberFormat({view.custom.value},{view.custom.format})"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "14px",
            "fontWeight": "bold",
            "padding": 7,
            "textAlign": "start"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "borderBottomLeftRadius": 10,
        "borderBottomRightRadius": 10,
        "borderTopLeftRadius": 10,
        "borderTopRightRadius": 10,
        "margin": 5,
        "marginLeft": 10,
        "marginRight": 10
      }
    },
    "type": "ia.container.flex"
  }
}