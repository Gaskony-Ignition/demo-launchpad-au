{
  "custom": {
    "format": "#,##0.##",
    "label": "Multiply production counter by this value to get output.  ",
    "units": "",
    "value": 1
  },
  "params": {
    "direction": "row",
    "header": "Outfeed Multiplier",
    "path": "[Launchpad]OEE/Demo/Line 1/Config/OutfeedFactor",
    "showUnits": false
  },
  "propConfig": {
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.FormatString"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.Documentation"
        },
        "transforms": [
          {
            "code": "\tif value \u003d\u003d \u0027\u0027:\n\t\treturn self.params.path.split(\u0027/\u0027)[-1]\n\telse:\n\t\treturn value",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.units": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngUnit"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.direction": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.header": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showUnits": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 65,
      "width": 569
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.direction"
              },
              "transforms": [
                {
                  "fallback": "25px",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "row",
                      "output": "75px"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.header"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/oee/text/label",
            "margin": 5
          },
          "textStyle": {
            "textAlign": "start"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "NumericEntryField"
            },
            "position": {
              "basis": "50px",
              "shrink": 0
            },
            "propConfig": {
              "props.format": {
                "binding": {
                  "config": {
                    "path": "view.custom.format"
                  },
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "path": "{view.params.path}"
                    },
                    "tagPath": "{path}"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "inputBounds": {
                "minimum": 0.0001
              },
              "style": {
                "classes": "launchpad/oee/control/text-entry-dark",
                "margin": "5px"
              }
            },
            "type": "ia.input.numeric-entry-field"
          },
          {
            "meta": {
              "name": "UnitsEntry"
            },
            "position": {
              "basis": "150px"
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "path": "view.params.showUnits"
                  },
                  "type": "property"
                }
              },
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.showUnits"
                  },
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "1": "{view.params.path}"
                    },
                    "tagPath": "{1}.EngUnit"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/oee/control/text-entry-dark",
                "margin": "5px"
              }
            },
            "type": "ia.input.text-field"
          },
          {
            "meta": {
              "name": "UnitsLabel"
            },
            "position": {
              "basis": "32px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "path": "view.params.showUnits"
                  },
                  "type": "property"
                }
              },
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.showUnits"
                  },
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"/minute\""
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/oee/text/label",
                "margin": "5px",
                "margin-top": 6,
                "textAlign": "start"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Entry"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.direction"
              },
              "transforms": [
                {
                  "fallback": "35px",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "row",
                      "output": "60px"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "margin": "5px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Info"
        },
        "propConfig": {
          "position.basis": {
            "binding": {
              "config": {
                "path": "view.params.direction"
              },
              "transforms": [
                {
                  "fallback": "35px",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "row",
                      "output": "600px"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderStyle": "none",
            "classes": "launchpad/oee/text/label",
            "margin": "5px",
            "padding": 5,
            "paddingBottom": 0,
            "paddingLeft": 0,
            "paddingRight": 0,
            "paddingTop": 0
          },
          "textStyle": {
            "textAlign": "start"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.direction": {
        "binding": {
          "config": {
            "path": "view.params.direction"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "style": {
        "classes": "Launchpad/Oee/CardSmall",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}