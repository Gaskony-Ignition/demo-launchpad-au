{
  "custom": {
    "background": "linear-gradient(to right,var(--oee-gray-a) 50.0%, var(--oee-gray-q) 0%)",
    "engHigh": 1,
    "engLow": 0,
    "format": "#0.0%",
    "label": "Line 7",
    "progress": 0.5,
    "units": "uom",
    "value": 0.5
  },
  "params": {
    "format": "#0.0%",
    "high": 1,
    "low": 0,
    "title": "Line 7",
    "units": "uom",
    "value": 0.5
  },
  "propConfig": {
    "custom.background": {
      "binding": {
        "config": {
          "path": "view.custom.progress"
        },
        "transforms": [
          {
            "code": "\treturn 'linear-gradient(to right,var(--oee-gray-a) %s%%, var(--oee-gray-q) 0%%)' % (value*100.0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.engHigh": {
      "binding": {
        "config": {
          "path": "view.params.high"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.engLow": {
      "binding": {
        "config": {
          "path": "view.params.low"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "path": "view.params.format"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "config": {
          "path": "view.params.title"
        },
        "transforms": [
          {
            "code": "\tif value == '':\n\t\treturn self.params.path.split('/')[-1]\n\telse:\n\t\treturn value",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.progress": {
      "binding": {
        "config": {
          "struct": {
            "engHigh": "{view.custom.engHigh}",
            "engLow": "{view.custom.engLow}",
            "value": "{view.custom.value}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tfullRange = value.engHigh - value.engLow\n\tvalueRange = value.value - value.engLow\n\treturn 1.0 * valueRange / fullRange",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.units": {
      "binding": {
        "config": {
          "path": "view.params.units"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.format": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.high": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.low": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.units": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 22,
      "width": 467
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "100px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "launchpad/oee/text/label",
            "marginRight": 5,
            "textAlign": "start",
            "cursor": "default"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "propConfig": {
          "props.style.background": {
            "binding": {
              "config": {
                "path": "view.custom.background"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "numberFormat({view.custom.value},{view.custom.format}) + ' ' + {view.custom.units}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "14px",
            "fontWeight": "bold",
            "padding": 7,
            "textAlign": "start",
            "cursor": "default"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "launchpad/oee/card"
      }
    },
    "type": "ia.container.flex"
  }
}