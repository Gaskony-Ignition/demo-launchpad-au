{
  "custom": {
    "background": "linear-gradient(to right,var(--oee-gray-a) 94.4444444444%, var(--oee-gray-q) 0%)",
    "label": "6/22/25, 10:00:00 PM",
    "progress": 0.9444444444444444,
    "value": 0.9444444444444444
  },
  "params": {
    "label": "6/22/25, 10:00:00 PM",
    "production": 850,
    "target": 900
  },
  "propConfig": {
    "custom.background": {
      "binding": {
        "config": {
          "path": "view.custom.progress"
        },
        "transforms": [
          {
            "code": "\treturn 'linear-gradient(to right,var(--oee-gray-a) %s%%, var(--oee-gray-q) 0%%)' % (value*100.0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "config": {
          "path": "view.params.label"
        },
        "transforms": [
          {
            "code": "\tif value == '':\n\t\treturn self.params.path.split('/')[-1]\n\telse:\n\t\treturn value",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.progress": {
      "binding": {
        "config": {
          "struct": {
            "production": "{view.params.production}",
            "target": "{view.params.target}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn value.production*1.0/value.target*1.0",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "struct": {
            "production": "{view.params.production}",
            "target": "{view.params.target}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn value.production*1.0/value.target*1.0",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.production": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.target": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 360
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "250px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.label"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/oee/text/label",
                "marginRight": 5,
                "textAlign": "start"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Percent"
            },
            "position": {
              "basis": "60px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.progress"
                  },
                  "transforms": [
                    {
                      "formatType": "numeric",
                      "formatValue": "#0.0%",
                      "type": "format"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "launchpad/oee/text/label",
                "marginRight": 5,
                "textAlign": "start"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "DatePercent"
        },
        "position": {
          "basis": "15px",
          "grow": 1
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "basis": "200px",
              "grow": 1
            },
            "propConfig": {
              "props.style.background": {
                "binding": {
                  "config": {
                    "path": "view.custom.background"
                  },
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.production"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "14px",
                "fontWeight": "bold",
                "key": "value",
                "padding": 7,
                "textAlign": "start"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Target"
            },
            "position": {
              "basis": "50px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.target"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "#FFFFFF",
                "fontSize": "14px",
                "fontWeight": "bold",
                "padding": 7,
                "textAlign": "start"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "15px",
          "grow": 1
        },
        "props": {
          "style": {
            "marginBottom": "10px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}