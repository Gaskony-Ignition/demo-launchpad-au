                "expression": "{this.custom.updateMode} || {this.custom.addMode}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "launchpad/oee/card"
          }
        },
        "scripts": {
          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "launchpadOeeRateMode",
              "pageScope": true,
              "script": "\tlaunchpad.views.ratesSetAddEditMode(self, payload)",
              "sessionScope": false,
              "viewScope": false
            }
          ]
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "custom.data": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "1"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\treturn launchpad.store.selectRates()\n"
            }
          ]
        }
      },
      "custom.database": {
        "binding": {
          "config": {
            "expression": "1"
          },
          "transforms": [
            {
              "code": "\treturn launchpad.oee.db()",
              "type": "script"
            }
          ],
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "launchpad/oee/card launchpad/oee/root"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "launchpadOeeRefreshRatesTable",
          "pageScope": true,
          "script": "\n\t# refresh rates\n\tself.refreshBinding(\"custom.data\")",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}
